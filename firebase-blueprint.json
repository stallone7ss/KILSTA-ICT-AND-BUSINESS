{
  "entities": {
    "Lead": {
      "title": "Lead",
      "description": "Client consultation and project inquiry records",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Full name of the contact person",
          "minLength": 2,
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Official email address"
        },
        "phone": {
          "type": "string",
          "description": "Phone number or WhatsApp contact",
          "maxLength": 30
        },
        "organization": {
          "type": "string",
          "description": "Business, cooperative, or community organization name",
          "maxLength": 150
        },
        "service_category": {
          "type": "string",
          "description": "Requested advisory or ICT service track",
          "maxLength": 100
        },
        "message": {
          "type": "string",
          "description": "Project requirements or scope details",
          "minLength": 5,
          "maxLength": 3000
        },
        "status": {
          "type": "string",
          "description": "Processing status of the lead",
          "enum": ["New", "In Review", "Contacted", "Proposal Sent", "Closed"]
        },
        "priority": {
          "type": "string",
          "description": "Priority tier of the inquiry",
          "enum": ["Standard", "High", "Urgent"]
        },
        "notes": {
          "type": "string",
          "description": "Administrative notes and follow-up log",
          "maxLength": 3000
        },
        "assigned_to": {
          "type": "string",
          "description": "Assigned KILSTA officer",
          "maxLength": 100
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Submission timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        }
      },
      "required": ["name", "email", "service_category", "message", "status"]
    }
  },
  "firestore": {
    "/leads/{leadId}": {
      "schema": "Lead",
      "description": "Collection of all public intake leads and corporate inquiries"
    }
  }
}
