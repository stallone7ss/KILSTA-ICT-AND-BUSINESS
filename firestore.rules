rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global catch-all default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidLead(data) {
      return data.keys().hasAll(['name', 'email', 'service_category', 'message', 'status']) &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 100 &&
        data.email is string && data.email.size() <= 150 &&
        data.service_category is string && data.service_category.size() <= 100 &&
        data.message is string && data.message.size() >= 5 && data.message.size() <= 3000 &&
        data.status is string && data.status in ['New', 'In Review', 'Contacted', 'Proposal Sent', 'Closed'];
    }

    match /leads/{leadId} {
      // Public visitors can submit inquiries
      allow create: if isValidId(leadId) && isValidLead(request.resource.data);
      // Authenticated console users & staff can read and manage leads
      allow read, update, delete: if request.auth != null;
    }
  }
}
